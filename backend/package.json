{
  "dependencies": {
    "@terreno/admin-backend": "^57.6.1",
    "@terreno/api": "^57.6.1",
    "@terreno/api-health": "^57.6.1",
    "luxon": "^3.7.2",
    "mongodb": "7.2.0",
    "mongoose": "9.7.4",
    "passport-local-mongoose": "^9.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@terreno/test": "^57.6.1",
    "@types/bun": "^1.4.0",
    "@types/chai": "^5.2.3",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/supertest": "^7.2.1",
    "chai": "^6.2.2",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3"
  },
  "name": "@sungold/backend",
  "overrides": {
    "bson": "7.2.0",
    "mongodb": "7.2.0"
  },
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "compile": "tsc",
    "dev": "PORT=4000 bun run --watch src/index.ts",
    "format": "biome format --write .",
    "grant-key": "bun run src/scripts/generateGrantKey.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:unsafefix": "biome check --write . --unsafe",
    "seed": "bun run src/scripts/seed.ts",
    "start": "bun run src/index.ts",
    "test": "bun test"
  },
  "type": "module",
  "version": "1.0.0"
}
