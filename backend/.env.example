# Copy to backend/.env and fill in production values (Secret Manager / platform secrets).
# MongoDB must be a replica set for sync and realtime — see deployment baseline docs.

MONGO_URI=mongodb://127.0.0.1:27017/sungold?replicaSet=rs0
AUTH_PROVIDER=better-auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com
TOKEN_SECRET=
TOKEN_ISSUER=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=
PORT=8080
NODE_ENV=production
