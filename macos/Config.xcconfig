// Local build settings for the Sungold Mac app.
// The network filter system extension needs a real team: ZKQE23T646 is the interim
// development team until the Gachnang LLC organization team exists (decision 0010).
// To build without a team, set DEVELOPMENT_TEAM empty and SUNGOLD_CODE_SIGN_IDENTITY to "-"
// (the filter will not install). Debug builds keep the device token in a user-only file,
// not the Keychain; see docs/how-to/run-the-mac-app.md.
DEVELOPMENT_TEAM = ZKQE23T646
SUNGOLD_CODE_SIGN_IDENTITY = Apple Development
SUNGOLD_BUNDLE_PREFIX = app.sungold
SUNGOLD_API_URL = http:/$()/localhost:4000
SUNGOLD_WEB_URL = http:/$()/localhost:8082
